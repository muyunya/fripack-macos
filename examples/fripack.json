{
  "macos": {
    "type": "shared",
    "platform": "macos-arm64",
    "entry": "./main.js",
    "xz": true,
    "outputDir": "./fripack",
    "targetBaseName": "myplugin",
    "payloadUrl": "https://github.com/muyunya/fripack-macos/releases/download/v1.0.0/fripack-inject-v1.0.0-{platform}.{ext}"
  },
  "macos-intel": {
    "inherit": "macos",
    "platform": "macos-x86_64",
    "targetBaseName": "myplugin-intel"
  }
}
